{% set sentence = params.context.sentences | getPrimarySentence %}

{% if forename and (params.earlyEngagement.completed | int < params.earlyEngagement.weeks | int) %}
    <p class='govuk-body'>
        You should see {{ forename }} every week for the first {{ params.earlyEngagement.weeks }} weeks of the sentence.
    </p>
{% endif %}

{% if forename and params.currentYear.appointments.allowance is defined and params.earlyEngagement.weeks is defined %}
    <p class='govuk-body'>Early engagement is expected to end on {{ params.currentPhase.endDate | dateWithYear }}{% if (params.earlyEngagement.completed | int < params.earlyEngagement.weeks | int) %} if {{ params.context.name.forename }} attends the required appointments by then{% endif %}.</p>
{% endif %}

{% if lifeCategoryCode == 'LF01' or lifeCategoryCode == 'LF02' or lifeCategoryCode == 'LF03' or lifeCategoryCode == 'x9'  %}
    {% include './_no-end-date.njk' %}
{% endif %}

{% if params.currentYear.appointments.allowance is defined and params.earlyEngagement.weeks is defined %}
    <p class='govuk-body'>
        {{ forename }} will then have a maximum of {{ (params.currentYear.appointments.allowance | int) - (params.earlyEngagement.weeks | int) }} supervision appointments for the rest of this sentence year.
    </p>
{% endif %}

{% if sentence.type.isCustodial %}
    {% if params.context.finalThirdEligibility.eligible == true %}
        <p class='govuk-body'>
            {{ forename }} is eligible to start the final third stage on {{ sentence.custody.finalThirdDate | dateWithYear }}.
        </p>
    {% elseif params.context.finalThirdEligibility.eligible == false%}
        <p class='govuk-body'>{{ forename }} is not eligible for the final third stage.</p>
    {% endif %}
{% endif %}

{% include './_progress-bar.njk' %}

{% if params.context | isEligibleForDiscretionaryAppointments(params.tierScore) %}
    <p class='govuk-body'>
        As a woman in tier {{ params.tierScore }}, {{ forename }} can have up to 5 additional discretionary appointments.
    </p>
{% endif %}
