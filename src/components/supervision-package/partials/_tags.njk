{% if params.currentYear.appointments.allowance is defined and not params.context.preventConcerns and params.currentYear.appointments.completed is defined and (params.currentYear.appointments.allowance | int) > 0 and (params.currentYear.appointments.completed | int) >= (params.currentYear.appointments.allowance | int) and not params.context.offenderPersonalDisorderPathway %}
    <strong class='app-status-badge govuk-tag govuk-tag--red'>No appointments remaining</strong>
{% endif %}

{% if sentence | isUnlawfullyAtLarge %}
    <strong class='app-status-badge govuk-tag govuk-tag--yellow'>Unlawfully at large</strong>
{% elseif sentence | hasRestrictedCustodyStatus %}
    <strong class='app-status-badge govuk-tag govuk-tag--yellow'>{{ sentence.custody.status.description | toTitleCase }}</strong>
{% elseif sentence.inBreach %}
     <strong class='app-status-badge govuk-tag govuk-tag--yellow'>In breach</strong>
{% endif %}

{% if params.context.preventConcerns %}
    <strong class='app-status-badge govuk-tag govuk-tag--blue'>Additional appointments needed</strong>
{% endif %}

{% if params.context.offenderPersonalDisorderPathway %}
    <strong class='app-status-badge govuk-tag govuk-tag--purple'>Offender personality disorder</strong>
{% endif %}

{% if params.context.integratedOffenderManagementRedRated %}
    <strong class='app-status-badge govuk-tag govuk-tag--red'>IOM (Integrated Offender Management): Red</strong>
{% endif %}
