{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% if params.phase.name.code == 'INIT' %}
  {% set completed = params.earlyEngagement.completed | int(0) %}
  {% set required = params.earlyEngagement.weeks | int(0) %}
{% else %}
  {% set completed = (params.currentYear.appointments.completed | int) - (params.earlyEngagement.completed | int(0)) %}
  {% set required = (params.currentYear.appointments.allowance | int) - (params.earlyEngagement.completed | int(0)) %}
{% endif %}

{% set stage = '' %}
{% if params.phase.code == 'INIT' %}
  {% set stage = 'early engagement' %}
{% elseif params.phase.code == 'STD' %}
  {% set stage = 'supervision' %}
{% endif %}

{% set forename = params.person.name.forename %}
<section class="supervision-package-summary">
  <h3 class='govuk-heading-m'>Supervision package summary</h3>
  <p class="govuk-body">{{ params.currentPhase.currentYear.appointments.completed }} of {{ params.currentPhase.currentYear.appointments.allowance }}
    {% if params.earlyEngagement %}early engagement{% endif %} appointments used</p>
  {{ govukSummaryList({
  rows: [
    {
      key: {
        text: "Required"
      },
      value: {
        text:  required
      }
    },
    {
      key: {
        text: "Remaining"
      },
      value: {
        text:  required - completed
      }
    },
    {
      key: {
        text: "Upcoming"
      },
      value: {
        html:  params.currentYear.appointments.scheduled | int
      }
    }  
  ]
}) }}
  {% if not params.context.finalThirdEligibility.eligible == true %}
    {% call govukDetails({
      summaryText: "Help with the " + stage + " stage"
    }) %}
    {% if params.phasecode == 'INIT' %}
      <p class="govuk-body">You should see {{ params.forename }} every week for the first {{ params.earlyEngagement.weeks }} weeks of the sentence.</p>
      <p class="govuk-body">Early engagement is expected to end on {{ params.earlyEngagement.endDate | dateWithYear }} if {{ params.forename }} attends the required appointments by then.</p>
      <p class="govuk-body">{{ params.forename }} will then have a maximum of {{ params.currentYear.appointments.allowance }} supervision appointments for the rest of this sentence year.</p>
    {% endif %}
    {% if params.phase.code == 'STD' %}
      <p class="govuk-body">{{ params.forename }} has a maximum of {{ required - completed}} appointments remaining.</p>
      <p class="govuk-body">
        {% if params.currentYear.isFirstYear %}
The supervision package ends on {{ params.currentYear.endDate | dateWithYear }}.
    {% else %}
 Appointments reset with the supervision package on {{ params.currentYear.endDate | dateWithYear }}.
    {% endif %}
      </p>
    {% endif %}
    {% endcall %}
  {% else %}
    <p class="govuk-body">{{ params.forename }} is in the final third of the sentence.</p>
    <p class="govuk-body">Meet {{ params.forename }} if there is a need for responsive management, risk or enforcement activity.</p>
  {% endif %}
</section>