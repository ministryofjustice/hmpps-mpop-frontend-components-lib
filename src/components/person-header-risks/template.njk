{%- from '../risk-flag-badge/macro.njk' import riskFlagBadge -%}

{# RSR / ROSH risk badges #}

{% if params.riskBadges and (params.riskBadges | trim) %}
    <div class='person-header__risk-panel'>
        <div
                class='person-header__risk-tags'
                data-qa='riskBadges'
        >
            {{ params.riskBadges | safe }}
        </div>
    </div>
{% endif %}

{% set personRiskFlags = params.personRiskFlags.headerBadges %}

{% if params.personRiskFlags.groups %}
    {% set personRiskFlags = [] %}
    {% for group in params.personRiskFlags.groups %}
        {% set personRiskFlags = personRiskFlags.concat(group.badges) %}
    {% endfor %}
{% endif %}

{% if personRiskFlags and personRiskFlags | length > 0 %}

    {# Person risk flags #}

    {# Unique per person so each toggle's aria-controls points at its own risk flags #}
    {% set riskFlagsId = 'person-header-risk-flags-' + params.crn %}

    <div class='person-header__risk-panel'>
        <div
                {% if params.collapsibleRiskFlags %}id='{{ riskFlagsId }}'{% endif %}
                class='person-header__risk-tags'
                data-qa='personRiskBadges'
        >
            {% for risk in personRiskFlags %}
                {{ riskFlagBadge({
                    href: '/case/' + params.crn + '/risk/flag/' + risk.id,
                    badgeClass: risk.badgeClass,
                    text: risk.text,
                    id: risk.id
                }) }}
            {% endfor %}

            {% if params.personRiskFlags.remainingCount > 0 %}
                <a
                        href='/case/{{ params.crn }}/risk'
                        class='govuk-link risk-badge-more'
                        data-qa='risk-badge-more'
                >
                    +{{ params.personRiskFlags.remainingCount }} active risk flags
                </a>
            {% endif %}
        </div>

        {% if params.collapsibleRiskFlags %}
            <button
                    type='button'
                    class='govuk-link person-header__risk-flags-toggle'
                    data-module='mpop-risk-flags-toggle'
                    data-show-text='Show active NDelius risk flags'
                    data-hide-text='Hide active NDelius risk flags'
                    aria-controls='{{ riskFlagsId }}'
                    aria-expanded='true'
                    data-qa='riskFlagsToggle'
                    hidden
            >
                Hide active NDelius risk flags
            </button>
        {% endif %}
    </div>
{% endif %}
